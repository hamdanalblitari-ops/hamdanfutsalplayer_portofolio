function renderGallery() {
    const grid = document.getElementById('gallery-grid');
    if (!grid) return;
    grid.innerHTML = '';
    const filtered = currentGalleryFilter === 'all' 
        ? galleryItems 
        : galleryItems.filter(item => item.category === currentGalleryFilter);

    if (filtered.length === 0) {
        grid.innerHTML = `<div class="col-span-full text-center py-10 bg-ef-card/40 border border-dashed border-ef-border rounded-xl"><p class="text-sm text-ef-muted">Belum ada foto.</p></div>`;
        return;
    }

    filtered.forEach(item => {
        const badgeColor = item.category === 'match' ? 'bg-ef-neon/20 text-ef-neon border-ef-neon/40' : item.category === 'training' ? 'bg-ef-cyan/20 text-ef-cyan border-ef-cyan/40' : 'bg-ef-yellow/20 text-ef-yellow border-ef-yellow/40';
        const card = document.createElement('div');
        card.className = 'group bg-ef-card border border-ef-border rounded-xl overflow-hidden flex flex-col justify-between hover:border-ef-neon/50 transition';
        card.innerHTML = `
            <div class="relative aspect-video bg-ef-bg overflow-hidden">
                <img src="${item.img}" alt="${item.title}" onerror="this.src='https://placehold.co/600x400/11151c/8b9bb4?text=Foto'" class="w-full h-full object-cover transition duration-500 group-hover:scale-105">
                <span class="absolute top-3 left-3 px-2.5 py-0.5 rounded text-[10px] font-tech font-bold uppercase border backdrop-blur-md ${badgeColor}">${item.category}</span>
                <button onclick="deleteGalleryItem(${item.id})" class="absolute top-3 right-3 w-7 h-7 rounded-lg bg-black/70 hover:bg-red-500 text-white opacity-0 group-hover:opacity-100 transition flex items-center justify-center text-xs"><i class="fa-solid fa-trash"></i></button>
            </div>
            <div class="p-4">
                <h3 class="font-tech font-bold text-base text-white">${item.title}</h3>
                <p class="text-xs text-ef-muted mt-1">${item.caption || ''}</p>
            </div>
        `;
        grid.appendChild(card);
    });
}

function filterGallery(cat, ev) {
    currentGalleryFilter = cat;
    document.querySelectorAll('.gal-filter').forEach(btn => {
        btn.classList.remove('bg-ef-card', 'text-white', 'font-bold');
        btn.classList.add('text-ef-muted');
    });
    if (ev && ev.target) {
        ev.target.classList.add('bg-ef-card', 'text-white', 'font-bold');
        ev.target.classList.remove('text-ef-muted');
    }
    renderGallery();
}

