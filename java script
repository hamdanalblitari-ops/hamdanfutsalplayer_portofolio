function renderDrawerSliders() {
    const posContainer = document.getElementById('drawer-position-sliders');
    if (posContainer) {
        posContainer.innerHTML = positionRatings.map((pos, idx) => `
            <div>
                <div class="flex items-center justify-between text-xs mb-1">
                    <label class="text-slate-300 font-medium">${pos.name} <span class="text-ef-muted">(${pos.code})</span></label>
                    <span id="pos-val-label-${pos.id}" class="font-tech font-bold text-sm text-ef-neon">${pos.rating}</span>
                </div>
                <input type="range" min="1" max="100" value="${pos.rating}" class="ef-slider w-full" oninput="updatePositionRating(${idx}, this.value)">
            </div>
        `).join('');
    }

    const container = document.getElementById('drawer-sliders-container');
    if (!container) return;
    container.innerHTML = '';

    playerStats.forEach((cat, catIdx) => {
        const section = document.createElement('div');
        section.className = 'bg-ef-card border border-ef-border rounded-xl p-4 space-y-3';
        let slidersHtml = cat.stats.map((stat, statIdx) => {
            const st = getRatingStyle(stat.value);
            return `
                <div>
                    <div class="flex items-center justify-between text-xs mb-1">
                        <label for="slider-${stat.id}" class="text-slate-300 font-medium">${stat.name}</label>
                        <span id="val-label-${stat.id}" class="font-tech font-bold text-sm ${st.text}">${stat.value}</span>
                    </div>
                    <input type="range" id="slider-${stat.id}" min="1" max="100" value="${stat.value}" class="ef-slider w-full" oninput="updateSingleStat(${catIdx}, ${statIdx}, this.value)">
                </div>
            `;
        }).join('');

        section.innerHTML = `
            <h4 class="font-tech font-bold text-xs uppercase tracking-wider ${cat.accent} border-b border-ef-border pb-2">${cat.category} Attributes</h4>
            <div class="space-y-3">${slidersHtml}</div>
        `;
        container.appendChild(section);
    });
}

function updateSingleStat(catIdx, statIdx, newValue) {
    const val = parseInt(newValue, 10);
    playerStats[catIdx].stats[statIdx].value = val;
    const statObj = playerStats[catIdx].stats[statIdx];
    const labelEl = document.getElementById(`val-label-${statObj.id}`);
    if (labelEl) {
        const st = getRatingStyle(val);
        labelEl.textContent = val;
        labelEl.className = `font-tech font-bold text-sm ${st.text}`;
    }
    renderAttributes();
}

function updatePositionRating(idx, newValue) {
    const val = parseInt(newValue, 10);
    positionRatings[idx].rating = val;
    if (val >= 83) positionRatings[idx].familiarity = 'high';
    else if (val >= 78) positionRatings[idx].familiarity = 'partial';
    else if (val >= 70) positionRatings[idx].familiarity = 'low';
    else positionRatings[idx].familiarity = 'none';

    const labelEl = document.getElementById(`pos-val-label-${positionRatings[idx].id}`);
    if (labelEl) labelEl.textContent = val;
    renderPositionGrid();
}

function saveAndCloseDrawer() {
    localStorage.setItem('hamdan_futsal_stats', JSON.stringify(playerStats));
    localStorage.setItem('hamdan_futsal_positions', JSON.stringify(positionRatings));
    toggleStatsDrawer();
    showToast('Statistik & rating posisi berhasil diperbarui!');
}

function resetStatsToDefault() {
    playerStats = JSON.parse(JSON.stringify(DEFAULT_ATTRIBUTES));
    positionRatings = JSON.parse(JSON.stringify(DEFAULT_POSITIONS));
    localStorage.removeItem('hamdan_futsal_stats');
    localStorage.removeItem('hamdan_futsal_positions');
    renderAttributes();
    renderPositionGrid();
    renderDrawerSliders();
    showToast('Statistik dikembalikan ke nilai awal.');
}

function toggleStatsDrawer() {
    const drawer = document.getElementById('stats-drawer');
    const backdrop = document.getElementById('stats-drawer-backdrop');
    const isClosed = drawer.classList.contains('translate-x-full');
    if (isClosed) {
        renderDrawerSliders();
        drawer.classList.remove('translate-x-full');
        backdrop.classList.remove('hidden');
    } else {
        drawer.classList.add('translate-x-full');
        backdrop.classList.add('hidden');
    }
}

function handlePlayerPhotoUpload(event) {
    const file = event.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = function(e) {
        const dataUrl = e.target.result;
        document.getElementById('player-card-photo').src = dataUrl;
        localStorage.setItem('hamdan_player_photo', dataUrl);
        showToast('Foto Player Card berhasil diganti!');
    };
    reader.readAsDataURL(file);
}

function applyPlayerPhotoUrl() {
    const url = document.getElementById('photo-url-input').value.trim();
    if (!url) return;
    document.getElementById('player-card-photo').src = url;
    localStorage.setItem('hamdan_player_photo', url);
    showToast('Foto Player Card berhasil diperbarui!');
}

