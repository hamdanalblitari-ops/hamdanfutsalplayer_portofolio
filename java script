function setBioLang(mode) {
    const idCard = document.getElementById('bio-id');
    const enCard = document.getElementById('bio-en');
    const container = document.getElementById('bio-container');

    ['both', 'id', 'en'].forEach(m => {
        const btn = document.getElementById(`btn-lang-${m}`);
        if (btn) btn.className = m === mode ? 'px-3 py-1.5 rounded-lg text-xs font-tech font-bold uppercase tracking-wider bg-ef-card text-ef-neon border border-ef-neon/30 transition' : 'px-3 py-1.5 rounded-lg text-xs font-tech font-bold uppercase tracking-wider text-ef-muted hover:text-white transition';
    });

    if (mode === 'both') {
        idCard.classList.remove('hidden');
        enCard.classList.remove('hidden');
        container.className = 'grid grid-cols-1 md:grid-cols-2 gap-6';
    } else if (mode === 'id') {
        idCard.classList.remove('hidden');
        enCard.classList.add('hidden');
        container.className = 'grid grid-cols-1 gap-6';
    } else {
        idCard.classList.add('hidden');
        enCard.classList.remove('hidden');
        container.className = 'grid grid-cols-1 gap-6';
    }
}

