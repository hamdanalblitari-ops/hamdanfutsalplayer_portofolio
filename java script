function handleAddGalleryItem(e) {
    e.preventDefault();
    const title = document.getElementById('gal-title').value.trim();
    const category = document.getElementById('gal-category').value;
    const caption = document.getElementById('gal-caption').value.trim();
    const urlInput = document.getElementById('gal-url').value.trim();
    const fileInput = document.getElementById('gal-file').files[0];

    const finalizeAdd = (imgSrc) => {
        galleryItems.unshift({ id: Date.now(), title, category, caption, img: imgSrc });
        localStorage.setItem('hamdan_futsal_gallery', JSON.stringify(galleryItems));
        renderGallery();
        closeAddPhotoModal();
        e.target.reset();
        showToast('Foto baru ditambahkan ke galeri!');
    };

    if (fileInput) {
        const reader = new FileReader();
        reader.onload = (ev) => finalizeAdd(ev.target.result);
        reader.readAsDataURL(fileInput);
    } else if (urlInput) {
        finalizeAdd(urlInput);
    } else {
        finalizeAdd(`https://placehold.co/600x400/11151c/00ff87?text=${encodeURIComponent(title)}`);
    }
}

function deleteGalleryItem(id) {
    galleryItems = galleryItems.filter(item => item.id !== id);
    localStorage.setItem('hamdan_futsal_gallery', JSON.stringify(galleryItems));
    renderGallery();
    showToast('Item galeri dihapus.');
}

