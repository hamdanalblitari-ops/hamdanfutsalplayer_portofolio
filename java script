// 7. INITIALIZATION ON PAGE LOAD
// =========================================================================
window.addEventListener('DOMContentLoaded', () => {
    const savedTheme = localStorage.getItem('hamdan_futsal_theme');
    const htmlEl = document.documentElement;
    const themeIcon = document.getElementById('theme-icon');
    if (savedTheme === 'light') {
        htmlEl.classList.remove('dark');
        htmlEl.classList.add('light');
        if (themeIcon) themeIcon.className = 'fa-solid fa-sun';
    } else {
        htmlEl.classList.add('dark');
        if (themeIcon) themeIcon.className = 'fa-solid fa-moon';
    }

    const savedPhoto = localStorage.getItem('hamdan_player_photo');
    if (savedPhoto) document.getElementById('player-card-photo').src = savedPhoto;
    
    renderAttributes();
    renderPositionGrid();
    renderGallery();

    // Scroll Spy for Navbar Active State
    const sections = document.querySelectorAll('section[id]');
    const navLinks = document.querySelectorAll('.nav-link');

    const observerOptions = {
        root: null,
        rootMargin: '-20% 0px -60% 0px',
        threshold: 0
    };

    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                const id = entry.target.getAttribute('id');
                navLinks.forEach(link => {
                    if (link.getAttribute('data-target') === id) {
                        link.className = 'nav-link px-3.5 py-1.5 rounded-lg text-xs font-tech font-semibold uppercase tracking-wider text-white bg-ef-card border border-ef-border/80 transition shadow-sm';
                    } else {
                        link.className = 'nav-link px-3.5 py-1.5 rounded-lg text-xs font-tech font-semibold uppercase tracking-wider text-ef-muted hover:text-white transition';
                    }
                });
            }
        });
    }, observerOptions);

    sections.forEach(section => observer.observe(section));
});
