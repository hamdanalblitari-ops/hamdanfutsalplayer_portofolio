function renderPositionGrid() {
    const grid = document.getElementById('position-rating-grid');
    if (!grid) return;
    const posMap = {};
    positionRatings.forEach(p => posMap[p.id] = p);

    const getTileStyle = (fam) => {
        if (fam === 'high') return { bg: 'bg-[#00e676] shadow-[0_0_15px_rgba(0,230,118,0.28)] border border-emerald-300/60', code: 'text-[#052e16]', val: 'text-[#052e16]' };
        if (fam === 'partial') return { bg: 'bg-[#064e3b] border border-emerald-500/40', code: 'text-emerald-300', val: 'text-white' };
        if (fam === 'low') return { bg: 'bg-[#1a222d] border border-slate-700/80', code: 'text-slate-400', val: 'text-slate-200' };
        return { bg: 'bg-[#141922] border border-slate-800/80 opacity-75', code: 'text-slate-500', val: 'text-slate-400' };
    };

    const renderTile = (pos, extraClass = '') => {
        const st = getTileStyle(pos.familiarity);
        return `
            <div onclick="toggleStatsDrawer('positions')" title="Klik untuk ubah rating ${pos.name}" 
                 class="${st.bg} ${extraClass} rounded-lg p-2.5 flex flex-col items-center justify-center cursor-pointer hover:scale-[1.03] transition select-none">
                <span class="font-tech font-bold text-[11px] uppercase tracking-wider ${st.code}">${pos.code}</span>
                <span class="font-tech font-bold text-xl sm:text-2xl leading-tight ${st.val}">${pos.rating}</span>
                <span class="text-[9px] font-medium ${st.code} opacity-85 truncate max-w-full">${pos.name}</span>
            </div>
        `;
    };

    grid.innerHTML = `
        ${renderTile(posMap.lf)}
        ${renderTile(posMap.pvt)}
        ${renderTile(posMap.rf)}
        <div class="col-span-3 grid grid-cols-3 gap-2.5">
            <div></div>
            ${renderTile(posMap.anc)}
            <div></div>
        </div>
        <div class="col-span-3 grid grid-cols-3 gap-2.5">
            <div></div>
            ${renderTile(posMap.gk)}
            <div></div>
        </div>
    `;
}

function getRatingStyle(val) {
    if (val >= 90) return { text: 'text-ef-neon', bar: 'bg-ef-neon', badge: 'bg-ef-neon/15 border-ef-neon/40' };
    if (val >= 80) return { text: 'text-ef-cyan', bar: 'bg-ef-cyan', badge: 'bg-ef-cyan/15 border-ef-cyan/40' };
    if (val >= 70) return { text: 'text-ef-yellow', bar: 'bg-ef-yellow', badge: 'bg-ef-yellow/15 border-ef-yellow/40' };
    return { text: 'text-slate-300', bar: 'bg-slate-400', badge: 'bg-slate-700/40 border-slate-600' };
}

function calculateOverallRating() {
    let total = 0, count = 0;
    playerStats.forEach(cat => {
        cat.stats.forEach(s => { total += Number(s.value); count++; });
    });
    return Math.round(total / count);
}

function renderAttributes() {
    const grid = document.getElementById('attributes-grid');
    if (!grid) return;
    grid.innerHTML = '';

    playerStats.forEach(cat => {
        const catAvg = Math.round(cat.stats.reduce((acc, s) => acc + Number(s.value), 0) / cat.stats.length);
        const catStyle = getRatingStyle(catAvg);

        const card = document.createElement('div');
        card.className = 'bg-ef-card/90 border border-ef-border rounded-xl p-4 flex flex-col justify-between hover:border-ef-border/100 transition';

        let statsHtml = cat.stats.map(stat => {
            const st = getRatingStyle(stat.value);
            let tagHtml = '';
            if (stat.isStrength) tagHtml = `<span class="text-[9px] font-tech uppercase px-1.5 py-0.2 rounded bg-ef-neon/15 text-ef-neon border border-ef-neon/30 ml-1.5">KEY</span>`;
            else if (stat.isDev) tagHtml = `<span class="text-[9px] font-tech uppercase px-1.5 py-0.2 rounded bg-ef-yellow/15 text-ef-yellow border border-ef-yellow/30 ml-1.5">DEV</span>`;

            return `
                <div>
                    <div class="flex items-center justify-between text-xs mb-1">
                        <span class="text-slate-200 font-medium">${stat.name} ${tagHtml}</span>
                        <span class="font-tech font-bold text-sm ${st.text}">${stat.value}</span>
                    </div>
                    <div class="w-full h-2 bg-ef-bg rounded-full overflow-hidden border border-ef-border/60">
                        <div class="stat-bar-fill h-full rounded-full ${st.bar}" style="width: ${stat.value}%"></div>
                    </div>
                </div>
            `;
        }).join('');

        card.innerHTML = `
            <div>
                <div class="flex items-center justify-between border-b border-ef-border pb-3 mb-4">
                    <div class="flex items-center gap-2">
                        <i class="fa-solid ${cat.icon} ${cat.accent}"></i>
                        <h3 class="font-tech font-bold text-base uppercase tracking-wider text-white">${cat.category}</h3>
                    </div>
                    <span class="font-tech font-bold text-xs px-2 py-0.5 rounded border ${catStyle.badge} ${catStyle.text}">AVG ${catAvg}</span>
                </div>
                <div class="space-y-3.5">${statsHtml}</div>
            </div>
        `;
        grid.appendChild(card);
    });

    const ovr = calculateOverallRating();
    const cardOvrEl = document.getElementById('card-ovr');
    const drawerOvrEl = document.getElementById('drawer-ovr-preview');
    if (cardOvrEl) cardOvrEl.textContent = ovr;
    if (drawerOvrEl) drawerOvrEl.textContent = ovr;
}

